{
  "manifest_version": 3,
  "name": "Bence's Social Block",
  "short_name": "Social Block",
  "description": "Hide the feeds, Shorts, Reels and pages that distract you on YouTube and Facebook. Filter YouTube by channel.",
  "homepage_url": "https://github.com/bence-drimus/bences-social-block",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "105",
  "browser_specific_settings": {
    "gecko": {
      "id": "bences-social-block@bence-drimus",
      "strict_min_version": "127.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
